DATABASE_URL=postgresql://user:password@localhost:5432/audio_processor
SECRET_KEY=change-me
# ALGORITHM=HS256

# Device used by faster-whisper, NLLB translation, and MeloTTS.
# "cpu"  - always use CPU (safe default, works everywhere)
# "cuda" - always use GPU (requires a CUDA-enabled torch install + NVIDIA GPU)
# "auto" - use GPU if available, otherwise fall back to CPU
DEVICE=cpu

# faster-whisper batch size. 1 = default single-stream transcription (lowest RAM, safest for
# modest machines, and the most accurate — recommended). Values > 1 enable
# BatchedInferencePipeline, which trades significantly higher RAM usage (roughly 2-2.5x at
# batch_size=8) for faster throughput on GPUs or when transcribing many files in parallel.
# On a single CPU-bound file it showed no speed benefit and measurably *worse* transcription
# accuracy in testing (dropped/duplicated words, overlapping segment timestamps) — only enable
# this if you have GPU/RAM headroom to spare and have verified output quality for your use case.
STT_BATCH_SIZE=1

# faster-whisper model size. Bigger = more accurate, slower, more RAM/VRAM.
# One of: tiny, small, medium, large-v3, large-v3-turbo
WHISPER_MODEL=large-v3-turbo

# NLLB translation model size. Bigger = better translation quality, slower, more RAM/VRAM.
# One of: facebook/nllb-200-distilled-600M, facebook/nllb-200-distilled-1.3B, facebook/nllb-200-3.3B
NLLB_MODEL=facebook/nllb-200-distilled-600M
